# --- Server ---
PORT=3000

# Path to the SQLite database file.
DATABASE_PATH=./data/ci-ledger.db

# --- GitHub App credentials ---
# From https://github.com/settings/apps/<your-app>
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# The webhook secret you set when creating the App. Required: webhook
# deliveries with an invalid signature are rejected.
GITHUB_WEBHOOK_SECRET=

# --- Ingest auth ---
# Shared bearer token that CI jobs use to POST JUnit results to /v1/ingest/junit.
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# --- Cost model (USD per minute, GitHub-hosted runners) ---
# Override to match your plan or self-hosted amortised rates.
RATE_LINUX_USD_PER_MIN=0.008
RATE_WINDOWS_USD_PER_MIN=0.016
RATE_MACOS_USD_PER_MIN=0.08

# --- Flake detection tuning ---
# Minimum observations before a test can be called flaky on statistics alone.
FLAKE_MIN_RUNS=5
# Minimum pass/fail flip rate (0-1) to classify as flaky.
FLAKE_FLIP_RATE_THRESHOLD=0.15
# How many recent runs per test are considered.
FLAKE_WINDOW_SIZE=50

# Set to 'true' to post PR comments. Leave unset while testing.
POST_PR_COMMENTS=false
