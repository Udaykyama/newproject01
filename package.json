{
  "name": "ci-ledger",
  "version": "0.1.0",
  "description": "Flaky-test detection and CI cost attribution, delivered as a GitHub App.",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/Udaykyama/newproject01"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ci-ledger": "dist/src/cli.js"
  }
}
